# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Solo en Vercel: protege /api/keepalive (Vercel lo manda solo al cron)
CRON_SECRET=una-cadena-larga-aleatoria

# ── Correo /mails (solo en Vercel, NUNCA con prefijo VITE_) ──
# Supabase → Project Settings → API Keys → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Resend → API Keys (permiso "Full access" o "Sending" + lectura de recibidos)
RESEND_API_KEY=re_...
# Resend → Webhooks → el de /api/mail/inbound → Signing secret
RESEND_WEBHOOK_SECRET=whsec_...
